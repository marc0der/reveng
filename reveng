#!/usr/bin/env bash
set -euo pipefail

VERSION="0.2.0"
CONFIG_DIR="${REVENG_CONFIG_DIR:-$HOME/.config/reveng}"
PLUGIN_DIR="$CONFIG_DIR/plugin"

# Default models per command
CURATE_DEFAULT_MODEL="opus"
SYNTH_DEFAULT_MODEL="opus"
DECOMPOSE_DEFAULT_MODEL="opus"

# ── Usage ────────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: reveng <command> [options]

Commands:
  curate       Prepare screenshots and transcripts for analysis
  synth        Run analysis agents and produce the PRD
  decompose    Decompose the PRD into feature specifications
  sandbox      Start a devcontainer for the current project
  init         Scaffold directory structure and .gitignore
  version      Print version and exit
  help         Show this help message

Global options (for commands that invoke Claude):
  -m, --model MODEL   Claude model to use (default varies by command)
  -v, --verbose        Show Claude commands and raw output
  --dry-run            Print what would be executed without running
  -h, --help           Show help for a command

Run 'reveng <command> --help' for command-specific usage.
EOF
}

# ── Shared helpers ───────────────────────────────────────────────────────────

warn_permissions() {
  if [[ "${DEVCONTAINER:-}" == "true" ]]; then
    return 0
  fi

  echo "⚠️  WARNING: Running with --dangerously-skip-permissions outside a container." >&2
  echo "⚠️  Claude will have unrestricted access to tools (file writes, shell commands, etc)." >&2
  echo "⚠️  For safer execution, use a devcontainer or container sandbox." >&2

  if [[ ! -t 0 ]]; then
    return 0
  fi

  local reply
  printf "Continue anyway? [y/N]: " >&2
  read -r reply
  if [[ ! "$reply" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    echo "Aborted." >&2
    exit 1
  fi
}

check_workspace_initialised() {
  if [[ ! -d ".claude/agents" ]]; then
    echo "Error: this workspace has not been initialised." >&2
    echo "Run 'reveng init' first." >&2
    return 1
  fi
}

stream_progress() {
  # -R + fromjson? so a non-JSON line (e.g. a warning on Claude's stderr) is
  # skipped rather than aborting the progress display mid-run.
  jq -rR --unbuffered '
    def shorten($n): if length > $n then .[:$n-1] + "…" else . end;
    fromjson? |
    if .type == "system" and .subtype == "init" then
      "▸ Starting Claude session (model: " + (.model // "?") + ")"
    elif .type == "assistant" then
      (.message.content // [])[]? |
      if .type == "text" then
        if (.text // "" | length) > 0
        then "  " + (.text | split("\n")[0] | shorten(120))
        else empty end
      elif .type == "tool_use" then
        "▸ " + .name +
        (if .name == "Bash" then ": " + ((.input.description // .input.command // "") | tostring | shorten(80))
         elif .name == "Read" or .name == "Write" or .name == "Edit" or .name == "NotebookEdit" then ": " + (.input.file_path // "")
         elif .name == "Glob" then ": " + (.input.pattern // "")
         elif .name == "Grep" then ": " + (.input.pattern // "") + (if .input.path then " in " + .input.path else "" end)
         elif .name == "Skill" then ": " + (.input.skill // "")
         elif .name == "Task" then ": " + ((.input.subagent_type // .input.description // "") | tostring | shorten(80))
         else "" end)
      else empty
      end
    elif .type == "result" then
      "✓ Done" + (if .duration_ms then " (" + ((.duration_ms / 1000) | floor | tostring) + "s)" else "" end)
    else empty
    end
  ' 2>/dev/null
}

# Establish the run identity recorded against every metrics row for this run.
# Format: <command>-<model>-<timestamp>, e.g. synth-fable-20260821-142233.
# Override with --run-id for a stable label when comparing runs.
init_run_id() {
  REVENG_CMD="$1"
  REVENG_RUN_ID="${RUN_ID:-${1}-${2}-$(date +%Y%m%d-%H%M%S)}"
  export REVENG_CMD REVENG_RUN_ID
}

# Append one JSONL row per Claude invocation. The result event carries the
# authoritative cost for the whole run — every turn and sub-agent already
# aggregated — so there is no pricing table to maintain here.
record_run_metrics() {
  local raw_log="$1" model="$2"
  local out="${REVENG_METRICS_LOG:-${REVENG_CONFIG_DIR:-$HOME/.config/reveng}/metrics.jsonl}"
  [[ -f "$raw_log" ]] || return 0
  mkdir -p "$(dirname "$out")" 2>/dev/null || return 0

  jq -cR --arg run_id "${REVENG_RUN_ID:-unknown}" \
        --arg command "${REVENG_CMD:-unknown}" \
        --arg model "$model" \
        --arg phase "${REVENG_PHASE:-/${REVENG_CMD:-unknown}}" \
        --arg workspace "$(basename "$PWD")" \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    fromjson? | select(.type == "result") | {
      ts: $ts, run_id: $run_id, command: $command, model: $model,
      phase: $phase, workspace: $workspace,
      cost_usd: .total_cost_usd, duration_ms: .duration_ms,
      num_turns: .num_turns, is_error: .is_error,
      input_tokens: .usage.input_tokens,
      output_tokens: .usage.output_tokens,
      cache_read_tokens: .usage.cache_read_input_tokens,
      cache_write_tokens: .usage.cache_creation_input_tokens
    }' "$raw_log" >> "$out" 2>/dev/null || true
}

run_claude() {
  local prompt="$1"
  local model="$2"
  local verbose="${3:-false}"
  local dry_run="${4:-false}"

  check_workspace_initialised

  # Analyst runs on a large source tree routinely exceed Claude Code's default
  # background-task ceiling (600s), which terminates the agent mid-write and
  # leaves truncated output. 0 waits indefinitely. Respect an explicit override.
  export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS="${CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS:-0}"

  local cmd=(
    claude -p "$prompt"
    --dangerously-skip-permissions
    --output-format stream-json
    --verbose
    --model "$model"
  )

  if [[ "$dry_run" == "true" ]]; then
    echo "Would run:"
    echo "  ${cmd[*]}"
    return 0
  fi

  warn_permissions

  # Claude's stderr is merged into the JSON stream below, so any warning it
  # emits becomes a non-JSON line that would abort jq mid-run. Keep the raw
  # stream so such a line can be identified after the fact.
  local raw_log="${REVENG_RAW_LOG:-${TMPDIR:-/tmp}/reveng-raw-$$.jsonl}"

  local -a pipe_status=()
  if [[ "$verbose" == "true" ]]; then
    "${cmd[@]}" 2>&1 | tee "$raw_log" /dev/stderr | jq -rR --unbuffered 'fromjson? | select(.type == "result") | .result // empty'
    pipe_status=("${PIPESTATUS[@]}")
  else
    "${cmd[@]}" 2>&1 | tee "$raw_log" >(stream_progress >&2) | jq -rR --unbuffered 'fromjson? | select(.type == "result") | .result // empty'
    pipe_status=("${PIPESTATUS[@]}")
  fi

  local claude_exit="${pipe_status[0]:-0}"

  record_run_metrics "$raw_log" "$model"

  # Report any line that was not valid JSON, whether or not the run failed.
  if grep -qvE '^\{' "$raw_log" 2>/dev/null; then
    echo "Note: non-JSON lines in Claude's output stream (raw log: $raw_log):" >&2
    grep -nvE '^\{' "$raw_log" 2>/dev/null | grep -v '^[0-9]*:$' | head -5 >&2
  fi

  if [[ $claude_exit -ne 0 ]]; then
    echo "Error: Claude exited with status $claude_exit." >&2
    echo "Raw stream kept at: $raw_log" >&2
    return 1
  fi
}

ANALYSIS_FILES=(
  "output/domain-analysis.md"
  "output/interaction-analysis.md"
  "output/application-analysis.md"
  "output/database-analysis.md"
)

# Check one analysis file for the signatures of a run that was cut short.
# Echoes a problem description and returns 1, or returns 0 if the file looks sound.
check_analysis_complete() {
  local file="$1"

  if [[ ! -f "$file" ]]; then
    echo "missing"
    return 1
  fi

  local lines
  lines=$(wc -l < "$file" | tr -d ' ')
  if [[ "$lines" -lt 50 ]]; then
    echo "implausibly short ($lines lines)"
    return 1
  fi

  local placeholders
  placeholders=$(grep -ciE '\(populated below|_\(to be |^[[:space:]]*(TODO|TBD)\b|\bTBD\b' "$file" 2>/dev/null || true)
  if [[ "${placeholders:-0}" -gt 0 ]]; then
    echo "$placeholders unfilled placeholder(s) — agent deferred content it never wrote"
    return 1
  fi

  # A killed run stops mid-token. A finished one ends on punctuation, a table
  # row, a closing fence, or a heading.
  local last
  last=$(grep -vE '^[[:space:]]*$' "$file" | tail -1)
  if [[ ! "$last" =~ [.:!?\|\`\)\>_*\"\'[:digit:]-]$ && ! "$last" =~ ^\# ]]; then
    echo "ends mid-sentence: ...${last: -60}"
    return 1
  fi

  return 0
}

# Gate between the analysis phase and PRD synthesis.
validate_analyses() {
  local strict="${1:-true}"
  local -a problems=()

  local f detail
  for f in "${ANALYSIS_FILES[@]}"; do
    if ! detail=$(check_analysis_complete "$f"); then
      problems+=("$f: $detail")
    fi
  done

  if [[ ${#problems[@]} -eq 0 ]]; then
    echo "All four analyses look complete."
    return 0
  fi

  echo "Error: analysis files look incomplete:" >&2
  local p
  for p in "${problems[@]}"; do
    echo "  - $p" >&2
  done
  echo >&2
  echo "A likely cause is an agent being terminated before it finished writing." >&2
  echo "Delete the affected file(s) and re-run 'reveng synth' to regenerate them," >&2
  echo "or pass --force to synthesise the PRD from what is there." >&2

  if [[ "$strict" == "true" ]]; then
    return 1
  fi
  echo "Continuing anyway (--force)." >&2
  return 0
}

validate_inputs() {
  local check_type="$1"

  case "$check_type" in
    curate)
      local has_screenshots=false
      local has_transcripts=false
      for f in screenshots/*.png screenshots/*.jpg screenshots/*.jpeg screenshots/*.gif screenshots/*.bmp screenshots/*.webp; do
        if [[ -f "$f" ]]; then
          has_screenshots=true
          break
        fi
      done
      for f in transcripts/*.txt; do
        if [[ -f "$f" ]]; then
          has_transcripts=true
          break
        fi
      done
      if [[ "$has_screenshots" == "false" && "$has_transcripts" == "false" ]]; then
        echo "Error: no screenshots or transcripts found." >&2
        echo "Place files in screenshots/ and/or transcripts/ before running 'reveng curate'." >&2
        return 1
      fi
      ;;
    synth)
      local has_html=false
      local has_curated=false
      for f in output/html/*.html; do
        if [[ -f "$f" ]]; then
          has_html=true
          break
        fi
      done
      for f in output/transcripts/*_curated.txt; do
        if [[ -f "$f" ]]; then
          has_curated=true
          break
        fi
      done
      if [[ "$has_html" == "false" || "$has_curated" == "false" ]]; then
        echo "Error: no curated content found." >&2
        echo "Run 'reveng curate' first to prepare screenshots and transcripts." >&2
        return 1
      fi
      ;;
    decompose)
      if [[ ! -f "output/PRD.md" ]]; then
        echo "Error: output/PRD.md not found." >&2
        echo "Run 'reveng synth' first to produce the PRD." >&2
        return 1
      fi
      ;;
  esac
}

# ── Parse common flags ──────────────────────────────────────────────────────

parse_flags() {
  local default_model="$1"
  shift

  MODEL="$default_model"
  VERBOSE="false"
  DRY_RUN="false"
  SHOW_HELP="false"
  SYNTH_ANALYSES_ONLY="false"
  SYNTH_PRD_ONLY="false"
  SYNTH_FORCE="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--model)
        if [[ $# -lt 2 ]]; then
          echo "Error: --model requires an argument." >&2
          return 1
        fi
        MODEL="$2"
        shift 2
        ;;
      -v|--verbose)
        VERBOSE="true"
        shift
        ;;
      --dry-run)
        DRY_RUN="true"
        shift
        ;;
      --analyses-only)
        SYNTH_ANALYSES_ONLY="true"
        shift
        ;;
      --prd-only)
        SYNTH_PRD_ONLY="true"
        shift
        ;;
      --force)
        SYNTH_FORCE="true"
        shift
        ;;
      --run-id)
        if [[ $# -lt 2 ]]; then
          echo "Error: --run-id requires an argument." >&2
          return 1
        fi
        RUN_ID="$2"
        shift 2
        ;;
      -h|--help)
        SHOW_HELP="true"
        shift
        ;;
      *)
        echo "Error: unknown option '$1'" >&2
        return 1
        ;;
    esac
  done
}

# ── Commands ─────────────────────────────────────────────────────────────────

cmd_version() {
  echo "reveng $VERSION"
}

copy_with_skip() {
  local src_root="$1"
  local dst_root="$2"

  if [[ ! -d "$src_root" ]]; then
    return 0
  fi

  while IFS= read -r src_file; do
    local rel="${src_file#"$src_root"/}"
    local dst_file="$dst_root/$rel"
    if [[ -e "$dst_file" ]]; then
      echo "  Skipped (already exists): $dst_file"
    else
      mkdir -p "$(dirname "$dst_file")"
      cp "$src_file" "$dst_file"
      echo "  Copied: $dst_file"
    fi
  done < <(find "$src_root" -type f)
}

cmd_init() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage: reveng init

Scaffolds the expected directory structure, copies reveng's agents,
skills, and a workspace CLAUDE.md into the current directory, and
updates .gitignore.

Creates:
  screenshots/   transcripts/   src/   output/
  .claude/agents/   .claude/skills/   CLAUDE.md

Adds to .gitignore:
  .claude/
  output/html/
  output/transcripts/*_curated.txt

Existing files at the destination are skipped (with a warning), so
local edits to agents, skills, or CLAUDE.md are preserved. To refresh,
delete the file and re-run init.
EOF
    return 0
  fi

  if [[ ! -d "$PLUGIN_DIR" ]]; then
    echo "Error: reveng content not found at $PLUGIN_DIR." >&2
    echo "Run install.sh (or install.sh --update) to populate it." >&2
    return 1
  fi

  local dirs=(screenshots transcripts src output)
  for dir in "${dirs[@]}"; do
    mkdir -p "$dir"
    echo "Created $dir/"
  done

  echo "Copying agents to .claude/agents/..."
  copy_with_skip "$PLUGIN_DIR/agents" ".claude/agents"

  echo "Copying skills to .claude/skills/..."
  copy_with_skip "$PLUGIN_DIR/skills" ".claude/skills"

  if [[ -f "$PLUGIN_DIR/CLAUDE.md" ]]; then
    if [[ -e "CLAUDE.md" ]]; then
      echo "Skipped CLAUDE.md (already exists)"
    else
      cp "$PLUGIN_DIR/CLAUDE.md" "CLAUDE.md"
      echo "Created CLAUDE.md"
    fi
  fi

  local gitignore_entries=(".claude/" "output/html/" "output/transcripts/*_curated.txt")
  local touched=false
  for entry in "${gitignore_entries[@]}"; do
    if [[ ! -f .gitignore ]] || ! grep -qxF "$entry" .gitignore; then
      echo "$entry" >> .gitignore
      touched=true
    fi
  done

  if [[ "$touched" == "true" ]]; then
    echo "Updated .gitignore"
  else
    echo ".gitignore already up to date"
  fi
}

cmd_curate() {
  parse_flags "$CURATE_DEFAULT_MODEL" "$@"

  if [[ "$SHOW_HELP" == "true" ]]; then
    cat <<'EOF'
Usage: reveng curate [options]

Prepares raw screenshots and interview transcripts into structured,
analysis-ready outputs using the digital-content-curator agent.

Options:
  -m, --model MODEL   Claude model to use (default: opus)
  -v, --verbose        Show Claude commands and raw output
  --dry-run            Print what would be executed without running
  -h, --help           Show this help message
EOF
    return 0
  fi

  validate_inputs curate
  init_run_id "curate" "$MODEL"
  run_claude \
    "Run the \`digital-content-curator\` agent to prepare all the screenshots and transcripts for analysis." \
    "$MODEL" \
    "$VERBOSE" \
    "$DRY_RUN"
}

cmd_synth() {
  parse_flags "$SYNTH_DEFAULT_MODEL" "$@"

  if [[ "$SHOW_HELP" == "true" ]]; then
    cat <<'EOF'
Usage: reveng synth [options]

Runs the four analysis agents and synthesises results into a Product
Requirements Document using the product-manager agent.

Each analyst runs as its own Claude session, so each gets a full context
rather than a share of one. Existing analysis files are reused; analysts run
only for missing outputs. Analyses are checked for completeness before the
PRD is synthesised.

Options:
  -m, --model MODEL   Claude model to use (default: opus)
  -v, --verbose        Show Claude commands and raw output
  --dry-run            Print what would be executed without running
  --analyses-only      Run the analysts and stop before the PRD
  --prd-only           Skip the analysts and synthesise the PRD only
  --force              Synthesise the PRD even if analyses look incomplete
  -h, --help           Show this help message
EOF
    return 0
  fi

  validate_inputs synth
  init_run_id "synth" "$MODEL"

  if [[ "$SYNTH_PRD_ONLY" != "true" ]]; then
    cmd_synth_analyses || return 1
  fi

  if [[ "$SYNTH_ANALYSES_ONLY" == "true" ]]; then
    echo "Analyses complete. Run 'reveng synth --prd-only' to produce the PRD."
    return 0
  fi

  # Gate: never synthesise a PRD from truncated analyses without being asked to.
  if [[ "$DRY_RUN" != "true" ]]; then
    validate_analyses "$([[ "$SYNTH_FORCE" == "true" ]] && echo false || echo true)" || return 1
  fi

  echo "▸ Synthesising PRD"
  REVENG_PHASE="/synth/prd"
  run_claude \
    "Run the \`product-manager\` agent to produce the PRD. All four analysis files already exist in output/ — do not launch any analyst agents; read the four analysis files and synthesise output/PRD.md from them." \
    "$MODEL" \
    "$VERBOSE" \
    "$DRY_RUN"
}

# Run each analyst as its own top-level Claude session, skipping those whose
# output already exists. Sequential rather than parallel: these are large,
# long-running jobs and each needs a full context to itself.
cmd_synth_analyses() {
  local -a pending=()
  local agent out

  while IFS='|' read -r agent out; do
    [[ -z "$agent" ]] && continue
    if [[ -f "$out" ]]; then
      echo "▸ Reusing existing $out"
    else
      pending+=("$agent|$out")
    fi
  done <<'EOF'
business-analyst|output/domain-analysis.md
interaction-analyst|output/interaction-analysis.md
application-developer|output/application-analysis.md
database-analyst|output/database-analysis.md
EOF

  if [[ ${#pending[@]} -eq 0 ]]; then
    echo "All four analyses already present."
    return 0
  fi

  local entry
  for entry in "${pending[@]}"; do
    agent="${entry%%|*}"
    out="${entry##*|}"
    echo "▸ Running $agent → $out"
    REVENG_PHASE="/synth/analysis/$agent"
    if ! run_claude \
      "Run the \`$agent\` agent. Write its complete analysis to $out." \
      "$MODEL" \
      "$VERBOSE" \
      "$DRY_RUN"; then
      echo "Error: $agent failed. $out may be missing or incomplete." >&2
      return 1
    fi
  done
}

cmd_decompose() {
  parse_flags "$DECOMPOSE_DEFAULT_MODEL" "$@"

  if [[ "$SHOW_HELP" == "true" ]]; then
    cat <<'EOF'
Usage: reveng decompose [options]

Decomposes the PRD into individually deliverable feature specifications
using the prd-to-features agent.

Options:
  -m, --model MODEL   Claude model to use (default: opus)
  -v, --verbose        Show Claude commands and raw output
  --dry-run            Print what would be executed without running
  -h, --help           Show this help message
EOF
    return 0
  fi

  validate_inputs decompose
  init_run_id "decompose" "$MODEL"
  run_claude \
    "Run the \`prd-to-features\` agent to decompose the PRD into individual feature specifications." \
    "$MODEL" \
    "$VERBOSE" \
    "$DRY_RUN"
}

sandbox_clean() {
  local container_id
  container_id=$(docker ps -aq --filter "label=devcontainer.local_folder=$PWD" 2>/dev/null || true)

  if [[ -z "$container_id" ]]; then
    echo "No sandbox container found for this workspace." >&2
    return 1
  fi

  echo "Removing container $container_id..."
  docker rm -f "$container_id"
  echo "Sandbox container removed."
}

cmd_sandbox() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage: reveng sandbox [options]
       reveng sandbox clean

Starts or attaches to a devcontainer for the current project.

Subcommands:
  clean               Remove the project's container

Options:
  --rebuild            Rebuild the container image from scratch
  -h, --help           Show this help message
EOF
    return 0
  fi

  # Handle 'clean' subcommand
  if [[ "${1:-}" == "clean" ]]; then
    sandbox_clean
    return $?
  fi

  # Parse flags
  local rebuild=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rebuild)
        rebuild=true
        shift
        ;;
      *)
        echo "Error: unknown option '$1'" >&2
        return 1
        ;;
    esac
  done

  # ── Prerequisite checks ──────────────────────────────────────────────────

  if ! command -v devcontainer &>/dev/null; then
    echo "Error: 'devcontainer' CLI not found on PATH." >&2
    echo "Install it with: npm install -g @devcontainers/cli" >&2
    return 1
  fi

  if ! docker info &>/dev/null; then
    echo "Error: Docker is not running or not accessible." >&2
    return 1
  fi

  if ! git rev-parse --is-inside-work-tree &>/dev/null 2>&1; then
    echo "Error: current directory is not inside a git repository." >&2
    return 1
  fi

  local devcontainer_config="$CONFIG_DIR/container/devcontainer.json"
  if [[ ! -f "$devcontainer_config" ]]; then
    echo "Error: devcontainer config not found at $devcontainer_config" >&2
    echo "Run install.sh first to set up the container configuration." >&2
    return 1
  fi

  # ── Workspace hash ───────────────────────────────────────────────────────

  local workspace_hash
  workspace_hash=$(echo "$PWD" | md5sum | cut -c1-8)

  # ── Build mounts ─────────────────────────────────────────────────────────

  local mounts=()

  # reveng binary
  local reveng_bin
  reveng_bin=$(command -v reveng 2>/dev/null || true)
  if [[ -n "$reveng_bin" ]]; then
    mounts+=("--mount" "type=bind,source=$reveng_bin,target=/usr/local/bin/reveng")
  fi

  # Note: ~/.claude is mounted via devcontainer.json (not here) to avoid duplicate mounts.
  # Reveng's agents and skills travel with the workspace via .claude/ so no plugin mount is needed.

  # SSH keys (optional)
  if [[ -d "$HOME/.ssh" ]]; then
    mounts+=("--mount" "type=bind,source=$HOME/.ssh,target=/home/node/.ssh")
  fi

  # GitHub CLI auth (optional)
  if [[ -d "$HOME/.config/gh" ]]; then
    mounts+=("--mount" "type=bind,source=$HOME/.config/gh,target=/home/node/.config/gh")
  fi

  # SSH agent socket (optional)
  local ssh_mounts=()
  if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
    ssh_mounts+=("--mount" "type=bind,source=$SSH_AUTH_SOCK,target=/tmp/ssh-agent.sock")
  fi

  # Persistent shell history volume
  mounts+=("--mount" "type=volume,source=reveng-history-$workspace_hash,target=/commandhistory")

  # ── Build env passthrough ────────────────────────────────────────────────

  local remote_env=()

  # SSH_AUTH_SOCK rewritten to mounted path
  local ssh_env=()
  if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
    ssh_env+=("--remote-env" "SSH_AUTH_SOCK=/tmp/ssh-agent.sock")
  fi

  # Anthropic env vars
  if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
    remote_env+=("--remote-env" "ANTHROPIC_BASE_URL=$ANTHROPIC_BASE_URL")
  fi
  if [[ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
    remote_env+=("--remote-env" "ANTHROPIC_AUTH_TOKEN=$ANTHROPIC_AUTH_TOKEN")
  fi
  if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
    remote_env+=("--remote-env" "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY")
  fi

  # ── Build devcontainer up command ────────────────────────────────────────

  local up_cmd=(
    devcontainer up
    --workspace-folder "$PWD"
    --config "$devcontainer_config"
  )

  # Add mounts
  up_cmd+=("${mounts[@]}")
  up_cmd+=(${ssh_mounts[@]+"${ssh_mounts[@]}"})

  # Add env passthrough
  up_cmd+=(${remote_env[@]+"${remote_env[@]}"})
  up_cmd+=(${ssh_env[@]+"${ssh_env[@]}"})

  # Rebuild flags
  if [[ "$rebuild" == "true" ]]; then
    up_cmd+=("--remove-existing-container" "--build-no-cache")
  fi

  echo "Starting sandbox for $(basename "$PWD")..."
  "${up_cmd[@]}"

  # ── Exec into the container ──────────────────────────────────────────────

  local exec_cmd=(
    devcontainer exec
    --workspace-folder "$PWD"
    --config "$devcontainer_config"
  )

  exec_cmd+=(${remote_env[@]+"${remote_env[@]}"})
  exec_cmd+=(${ssh_env[@]+"${ssh_env[@]}"})

  exec_cmd+=(zsh)

  "${exec_cmd[@]}"
}

# ── Main dispatch ────────────────────────────────────────────────────────────

case "${1:-}" in
  curate)      shift; cmd_curate "$@" ;;
  synth)       shift; cmd_synth "$@" ;;
  decompose)   shift; cmd_decompose "$@" ;;
  sandbox)     shift; cmd_sandbox "$@" ;;
  init)        shift; cmd_init "$@" ;;
  version)     cmd_version ;;
  help|-h|--help) usage ;;
  "")          usage ;;
  *)           echo "Error: unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac
